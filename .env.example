APP_NAME=Usman Electronics
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Karachi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=usman_electronics
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Scheduler starts the queue worker every minute (needs the cron line in docs/GO_LIVE.md). false = Supervisor runs it.
QUEUE_WORKER_VIA_SCHEDULER=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Order requests (Cash on Delivery). Admin email falls back to the contact recipient in site settings.
ORDER_ADMIN_EMAIL=

# Owner WhatsApp alert: log | callmebot | cloud_api
WHATSAPP_DRIVER=log
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TO=
WHATSAPP_CLOUD_TEMPLATE=new_order_alert

# Optional Cloudflare Turnstile on checkout (leave empty to disable)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin panel (/admin). Create admins with: php artisan app:create-admin
# 2FA is required in production by default; set false only for local development.
ADMIN_REQUIRE_2FA=
# Optional: first Owner created by `php artisan db:seed --class=AdminUserSeeder` (local/dev convenience)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Going live: follow docs/GO_LIVE.md (full checklist) ---
# APP_ENV=production   APP_DEBUG=false   APP_URL=https://your-domain.pk
# SESSION_SECURE_COOKIE=true   (cookies only over HTTPS)
# Run after each deploy: php artisan migrate --force && php artisan storage:link && php artisan filament:assets
#                        php artisan app:optimize-images && php artisan optimize
# Keep a queue worker running (emails + WhatsApp): php artisan queue:work --tries=3
